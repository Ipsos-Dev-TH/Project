<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Project.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Project Management</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <!-- Google Fonts - Barlow -->
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Bootstrap CSS -->
    <webopt:bundlereference runat="server" path="~/Content/css" />

    <!-- Ipsos Theme -->
    <link rel="stylesheet" type="text/css" href="~/Content/ipsos-theme.css" />

    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
</head>
<body>
    <form runat="server">
        <!-- Ipsos Navbar -->
        <nav class="ipsos-navbar">
            <div class="ipsos-navbar-container">
                <a class="ipsos-navbar-brand" runat="server" href="~/Home">
                    <i class="fas fa-project-diagram"></i>
                    <span class="brand-text">Project Management</span>
                </a>

                <button type="button" class="navbar-toggle" onclick="toggleMenu()">
                    <i class="fas fa-bars"></i>
                </button>

                <ul class="ipsos-navbar-menu" id="navbarMenu">
                    <li class="ipsos-navbar-item">
                        <a class="ipsos-navbar-link" runat="server" href="~/Home">
                            <i class="fas fa-home"></i> <span>Home</span>
                        </a>
                    </li>
                    <li class="ipsos-navbar-item" id="AdminMenuItem" runat="server">
                        <a class="ipsos-navbar-link" runat="server" href="~/Admin">
                            <i class="fas fa-cog"></i> <span>Admin</span>
                        </a>
                    </li>
                    <li class="ipsos-navbar-item ipsos-navbar-user">
                        <i class="fas fa-user-circle"></i>
                        <asp:Label ID="CurrentUserLabel" runat="server" />
                    </li>
                    <li class="ipsos-navbar-item">
                        <asp:LinkButton ID="LogoutButton" runat="server" CssClass="ipsos-navbar-logout" OnClick="ImageButton1_Click">
                            <i class="fas fa-sign-out-alt"></i> <span>Logout</span>
                        </asp:LinkButton>
                    </li>
                </ul>
            </div>
        </nav>

        <script type="text/javascript">
            function toggleMenu() {
                var menu = document.getElementById('navbarMenu');
                menu.classList.toggle('show');
            }
        </script>

        <!-- Main Content -->
        <div class="ipsos-page-wrapper">
            <div class="ipsos-container">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </div>
        </div>

        <!-- Footer -->
        <footer class="ipsos-footer">
            <div class="ipsos-container">
                <p>&copy; <%: DateTime.Now.Year %> Ipsos Limited. All rights reserved.</p>
            </div>
        </footer>
    </form>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/jquery") %>
        <%: Scripts.Render("~/bundles/bootstrap") %>
    </asp:PlaceHolder>
</body>
</html>
